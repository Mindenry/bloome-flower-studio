# ---------------------------------------------------------------------------
# BLOOMÉ FLOWER STUDIO — Environment configuration
# Copy to .env.local and fill in real credentials. Never commit real secrets.
# ---------------------------------------------------------------------------

# Core -----------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
APP_NAME="BLOOMÉ FLOWER STUDIO"
# 32+ byte random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=replace-with-a-long-random-secret
# Secret for cron/maintenance endpoints (stock reservation expiry, abandoned carts)
CRON_SECRET=replace-with-another-random-secret
# Optional: restrict admin area to this IP allow-list (comma separated, empty = off)
ADMIN_IP_ALLOWLIST=

# Database -------------------------------------------------------------------
# Development default (zero-install SQLite file):
DATABASE_URL=file:./data/bloome.db
# Production (PostgreSQL):
# DATABASE_URL=postgresql://bloome:password@localhost:5432/bloome?schema=public
# For managed Postgres requiring TLS:
# DATABASE_SSL=true

# Auth — LINE Login (https://developers.line.biz/console/) -------------------
# Create a *LINE Login* channel (not Messaging API). Add the callback URL below.
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CALLBACK_URL=http://localhost:3000/api/auth/line/callback
LINE_LOGIN_SCOPE=profile openid email

# Auth — Google (https://console.cloud.google.com/apis/credentials) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Payments -------------------------------------------------------------------
# manual_bank_transfer | promptpay_omise | stripe | sandbox (development only)
PAYMENT_PROVIDER=manual_bank_transfer
PAYMENT_CURRENCY=THB

# Opn Payments / Omise (PromptPay QR, cards)
OMISE_PUBLIC_KEY=
OMISE_SECRET_KEY=
OMISE_API_VERSION=2019-05-29
# Omise does not sign webhooks; we re-verify every event against the Charges API.
# Optional shared secret appended to the webhook URL as ?key=<value>
OMISE_WEBHOOK_KEY=

# Stripe (cards + PromptPay)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Bank transfer / manual verification
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=
BANK_NAME=
BANK_BRANCH=

# Notification — Email (SMTP) -------------------------------------------------
MAIL_DRIVER=smtp            # smtp | log
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM="BLOOMÉ FLOWER STUDIO <hello@bloome.example>"
MAIL_REPLY_TO=hello@bloome.example

# Notification — LINE Messaging API (separate channel from LINE Login) -------
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=
LINE_MESSAGING_CHANNEL_SECRET=
LINE_OA_ADD_FRIEND_URL=

# Storage --------------------------------------------------------------------
# local | s3  (local is fine for development; S3/R2 is required in production)
STORAGE_DRIVER=local
UPLOAD_DIR=./public/uploads
PUBLIC_UPLOAD_PREFIX=/uploads
S3_BUCKET=
S3_REGION=ap-southeast-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# Seed / bootstrap -----------------------------------------------------------
SEED_ADMIN_EMAIL=admin@bloome.local
SEED_ADMIN_PASSWORD=ChangeMe!2026
SEED_DEMO_DATA=true
