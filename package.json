{
  "name": "bloome-flower-studio",
  "version": "1.0.0",
  "private": true,
  "description": "BLOOMÉ FLOWER STUDIO — premium bilingual (TH/EN) flower e-commerce platform",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/seed.ts",
    "db:reset": "tsx --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/reset.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "tsx --env-file-if-exists=.env.local scripts/e2e.ts",
    "smoke": "node scripts/smoke.mjs",
    "photos": "node scripts/fetch-pexels.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.6",
    "kysely": "^0.27.5",
    "next": "^15.5.29",
    "nodemailer": "^6.9.16",
    "pg": "^8.13.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.5.29",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "sharp@0.35.5": true,
    "sharp@0.33.5": true,
    "esbuild@0.21.5": true,
    "esbuild@0.28.2": true
  }
}
